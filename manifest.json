{
  "manifest_version": 2,
  "name": "ClickShell",
  "version": "2025.11.11",
  "description": "Execute shell commands on configurable modifier + click links",

  "icons": {
    "16": "mouse-icon.svg",
    "48": "mouse-icon.svg",
    "128": "mouse-icon.svg"
  },

  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "contextMenus"
  ],

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "clickshell@example.com"
    }
  }
}
